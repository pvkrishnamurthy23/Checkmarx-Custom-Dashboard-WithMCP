<!doctype html>
<html><body style="font-family:Segoe UI,Arial,sans-serif;color:#1b2430">
<h2 style="margin:0 0 8px">{{ c.title }}</h2>
<p style="margin:0 0 12px">Severity: <strong>{{ c.severity }}</strong></p>
{% if c.lines %}
<ul>
{% for line in c.lines %}
  <li>{{ line }}</li>
{% endfor %}
</ul>
{% endif %}
<p style="color:#6b7785;font-size:12px">Sent by the Checkmarx One dashboard. Findings text is escaped.</p>
</body></html>
