# Copy to .env and fill in. .env is git-ignored. NEVER commit real credentials.
# Unknown keys in .env are rejected at startup (typos fail fast).
# Do not put POSTGRES_* variables in this file; docker-compose sets them for the db service.

# ---------- Checkmarx One connection ----------
CX_REGION=eu                    # us | us2 | eu | eu2 | deu | anz | ind | sng | mea
CX_TENANT=your-tenant-name      # tenant (realm) name shown in your Checkmarx One URL
# Optional explicit overrides; if empty they are derived from CX_REGION. Set BOTH to use an unlisted region.
CX_BASE_URL=
CX_IAM_URL=
CX_UI_BASE_URL=                 # used for deep links; defaults to CX_BASE_URL
# Portal deep-link pattern. VERIFY against your portal (see docs/API_NOTES.md #5).
# Placeholders: {ui_base} {scan_id} {project_id} {engine} {finding_id}
CX_DEEPLINK_TEMPLATE={ui_base}/results/{scan_id}/{project_id}/{engine}

CX_AUTH_METHOD=api_key          # api_key | oauth_client
CX_API_KEY=                     # required when CX_AUTH_METHOD=api_key
CX_CLIENT_ID=                   # required when CX_AUTH_METHOD=oauth_client
CX_CLIENT_SECRET=

# ---------- Scope ----------
CX_BRANCHES=master,dis-devinteg # comma list, globs allowed (release/*); empty = all branches
CX_PROJECT_NAME_REGEX=          # optional include filter on project name (operator-supplied regex)
CX_PROJECT_TAGS=                # optional, comma list key[:value]; a project must match all
CX_APPLICATIONS=                # optional, comma list of application names
CX_ENGINES=sast,sca,containers,kics,secrets,apisec,sscs

# ---------- What counts as open ----------
CX_CLOSED_STATES=NOT_EXPLOITABLE   # comma list; every other state is open
CX_CLOSED_STATUSES=FIXED

# ---------- Sync ----------
SYNC_INVENTORY_MINUTES=30
SYNC_SCANS_MINUTES=10
SYNC_FINDINGS_CRON=0 2 * * *    # nightly full refresh of latest-scan findings + purge (UTC)
SYNC_BACKFILL_DAYS=90                  # only used when SYNC_SCAN_SELECTION=all
SYNC_REQUEST_POLL_SECONDS=30    # how often the worker checks on-demand refresh requests
# --- API-call economy (see README "Keeping API calls low", ADR 0013) ---
SYNC_SCAN_SELECTION=last_scan   # last_scan = only the newest scan per project+branch (needs exact CX_BRANCHES); all = every scan since a high-water mark
SYNC_LAST_SCAN_STATUS=Completed # only scans in this status count as "full" (Partial/Failed/Canceled are ignored)
SYNC_FULL_SCANS_ONLY=false      # true = also skip scans whose SAST config says incremental and look back for another (extra calls; the flag is the configured mode, not proof)
SYNC_FULL_SCAN_LOOKBACK=20      # how many recent scans to inspect when looking past an incremental one
SYNC_LAST_SCAN_BATCH=50         # project ids per last-scan call / scan ids per details call (50 verified)
SYNC_LOAD_FINDINGS=true         # false = counters only from scan-summary: no per-finding calls (cheapest; no grids, SLA, aging)
SYNC_NIGHTLY_FINDINGS_REFRESH=false  # true = re-download findings of every latest scan every night
SYNC_KEEP_SCAN_HISTORY=true     # false = nightly purge keeps only the latest scan per project/branch (no trend history)
SYNC_MAX_API_CALLS_PER_RUN=2500 # hard cap per job run (0 = unlimited); the next cycle resumes where it stopped
CX_RESULTS_PAGE_SIZE=500        # findings per results call (500 verified; a typical scan needs one call)
CX_PAGE_SIZE=100
CX_MAX_CONCURRENCY=5
CX_HTTP_TIMEOUT_SECONDS=60
CX_MAX_RETRIES=5
FINDINGS_KEEP_SCANS_PER_BRANCH=2   # latest N scans keep detail; older keep counters only

# ---------- Metrics ----------
SLA_DAYS_CRITICAL=7
SLA_DAYS_HIGH=30
SLA_DAYS_MEDIUM=90
SLA_DAYS_LOW=180
RISK_WEIGHT_CRITICAL=10
RISK_WEIGHT_HIGH=5
RISK_WEIGHT_MEDIUM=2
RISK_WEIGHT_LOW=0.5
STALE_PROJECT_DAYS=14

# ---------- Storage ----------
# Local dev default is SQLite. Production: postgresql+psycopg://user:password@host:5432/cxdash
DATABASE_URL=sqlite:///./cxdash-dev.db
REDIS_URL=                      # optional query cache, e.g. redis://redis:6379/0

# ---------- Dashboard auth ----------
AUTH_MODE=none                  # none | oidc | proxy_headers   (none = local development ONLY)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GROUP_CLAIM=groups
ROLE_ADMIN_GROUPS=              # comma list of IdP groups
ROLE_ANALYST_GROUPS=
TRUSTED_PROXY_IPS=              # required for proxy_headers: comma list of IPs/CIDRs of your reverse proxy
SESSION_SECRET=                 # >= 32 random chars; required for oidc (python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_COOKIE_SECURE=true      # keep true behind TLS; only relevant for oidc
SCOPE_MAP_PATH=                 # optional path to scope_map.yaml (group -> application names); off by default
METRICS_TOKEN=                  # optional bearer token for /metrics (otherwise admin role, or open when AUTH_MODE=none)

# ---------- Alerts ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_WEBHOOK_URL=              # Slack / Teams incoming webhook
ALERT_COOLDOWN_HOURS=24

# ---------- Web / ops ----------
WEB_HOST=127.0.0.1              # use 0.0.0.0 only inside a container behind your proxy
WEB_PORT=8050
WORKER_METRICS_HOST=127.0.0.1    # 0.0.0.0 only inside a private container network
WORKER_METRICS_PORT=9102        # 0 disables the worker's Prometheus endpoint
EXPORT_ROW_CAP=1000000
REFRESH_RATE_LIMIT_SECONDS=60
LOG_LEVEL=INFO
ENABLE_WRITEBACK=false          # reserved; true is rejected at startup in v1
